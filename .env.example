# Bu dosyayı .env olarak kopyala:  cp .env.example .env
# .env asla GitHub'a gitmez (.gitignore'da).

# ---- Çalışma modu ----
# paper : sadece simülasyon, API anahtarı gerekmez (varsayılan, en güvenli)
# demo  : Binance Demo Trading (sahte para). Anahtarlar: https://demo.binance.com/en/my/settings/api-management
# live  : GERÇEK PARA. Sadece LIVE_TRADING_CONFIRM doğru yazılırsa çalışır.
MODE=paper

# spot | futures  (futures = USDⓈ-M perpetual)
MARKET=spot

# ---- API anahtarları ----
# Gerçek hesapta anahtar oluştururken: "Enable Withdrawals" KAPALI, IP kısıtlaması AÇIK olsun.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# live modunda botun çalışması için tam olarak şunu yaz: I_UNDERSTAND_THE_RISK
LIVE_TRADING_CONFIRM=

# ---- Strateji ----
# ema_trend (önerilen) | donchian_breakout | rsi_reversion
STRATEGY=ema_trend
# 8 coine yaymak riski düşürüyor (tek coin yerine portföy). Futures'ta otomatik BTC/USDT:USDT olur.
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,LINK/USDT,DOGE/USDT
TIMEFRAME=4h

# ---- Risk profili ----
# conservative : %0.25 risk/işlem  (backtest 2021-26: yıllık ~%15, en kötü düşüş ~%8)
# balanced     : %0.5  risk/işlem  (backtest 2021-26: yıllık ~%29, en kötü düşüş ~%14)  <- varsayılan
# aggressive   : %0.75 risk/işlem  (backtest 2021-26: yıllık ~%53, en kötü düşüş ~%24)
# Saklı test dönemi 2025-26'da balanced: yıllık ~%9.5. Gelecek için garanti DEĞİL.
PROFILE=balanced

# Aşağıdakileri boş bırakırsan profil değerleri kullanılır. Doldurursan profili ezer.
# İşlem başına riske atılan özsermaye oranı (0.005 = %0.5)
RISK_PER_TRADE=
# Stop mesafesi = ATR * bu çarpan (dar stop = çok fazla gereksiz stop; 4-5 en iyisiydi)
ATR_STOP_MULT=
# Yeni long sadece BTC 200 EMA üstündeyken, short sadece altındayken (testlerde kaybı azalttı)
BTC_FILTER=true
# Stop'u fiyatla birlikte taşı (testlerde kapalı olması daha iyi sonuç verdi)
TRAILING_STOP=false
# Günlük zarar bu orana ulaşırsa bot o gün yeni işlem açmaz
MAX_DAILY_LOSS=
# Zirveden düşüş bu orana ulaşırsa bot pozisyonları kapatıp TAMAMEN durur
MAX_DRAWDOWN=
MAX_OPEN_POSITIONS=
# Futures kaldıraç üst sınırı (spot'ta her zaman 1)
MAX_LEVERAGE=3

# paper modunda başlangıç bakiyesi (USDT)
PAPER_START_BALANCE=1000

# ---- Ücretler ----
# Binance'te "BNB ile ücret öde" açıksa true yap (ücret %25 düşer). Hesapta biraz BNB olmalı.
BNB_FEE_DISCOUNT=false
# Girişlerde önce limit (maker) emir dene, MAKER_WAIT_SECONDS içinde dolmazsa kalanı piyasa emri.
# Çıkışlar ve stoplar her zaman piyasa emri (risk gecikmesin diye).
MAKER_FIRST=false
MAKER_WAIT_SECONDS=45

# ---- Telegram bildirimleri (isteğe bağlı) ----
# @BotFather -> /newbot -> token. Bota bir mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden "chat":{"id":...} değerini al.
# Test: python -m tradingbot notify-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Funding carry motoru (ayrı çalışır: python -m tradingbot carry-run) ----
# Spot long + futures short aynı coinde: fiyat yönünden bağımsız, funding geliri.
# Backtest 2021-24: yıllık ~%10, düşüş <%1. 2025-26: yıllık ~%0.4 (funding çok düştü).
# Spot VE USDⓈ-M futures cüzdanında USDT gerekir. 0 = kapalı.
CARRY_CAPITAL=0
CARRY_SLOTS=5
# Short tarafın kaldıracı (1-3). 2 = sermayenin 2/3'ü spot'ta, 1/3'ü teminat.
CARRY_LEVERAGE=2
# Son 9 funding (3 gün) ortalaması 8 saatte %0.01'i geçince gir, eksiye dönünce çık
CARRY_ENTER=0.0001
CARRY_EXIT=0
